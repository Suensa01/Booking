# Supabase Direct PostgreSQL Connection (Prisma ORM)
# Get from: Supabase Project -> Settings -> Database -> Connection string (URI)
# Pooler (port 6543) for application queries:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for schema push / migrations:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
